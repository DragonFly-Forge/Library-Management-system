<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Library Management System"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Status / Feedback Banner -->
        <TextView
            android:id="@+id/tvFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E2E8F0"
            android:padding="10dp"
            android:text="Ready."
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Task 1: Add New Book -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Add New Book"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etBookId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Book ID (e.g., 101)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Book Title"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/etAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Author Name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Publication Year (e.g., 2024)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etCopies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Available Copies"
            android:inputType="number" />

        <Button
            android:id="@+id/btnAddBook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Book"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <!-- Task 3: Search for a Book -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Search Book"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Book ID or Title"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvSearchResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:text="Search results will appear here."
            android:textColor="#334155"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <!-- Tasks 4 & 5: Issue / Return Book -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Issue / Return Book"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etActionBookId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Book ID"
            android:inputType="number" />

        <EditText
            android:id="@+id/etStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Student ID (e.g., STU01)"
            android:inputType="textCapCharacters" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnIssue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Issue Book"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnReturn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Return Book"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Task 2: All Registered Books -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. All Registered Books"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvBooksList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:text="No books registered yet."
            android:textColor="#1E293B"
            android:typeface="monospace"
            android:layout_marginBottom="20dp" />

        <!-- Task 6: Currently Issued Books -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. Currently Issued Books"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvIssuedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:text="No books currently issued."
            android:textColor="#1E293B"
            android:typeface="monospace"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>